# Campus Redressal Backend Environment Variables

# Server Port and Environment
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas or self-hosted)
# If omitted during local development, falls back automatically to In-Memory MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus-redressal?retryWrites=true&w=majority

# JWT Secret for Token Signing (Generate a secure random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Email Domain Restriction for Student Registration (e.g. college.edu)
ALLOWED_EMAIL_DOMAIN=college.edu

# Allowed Frontend URLs for CORS (comma-separated if multiple, e.g. https://campus.vercel.app,https://mycustomdomain.com)
FRONTEND_URL=http://localhost:5173,https://your-frontend-domain.vercel.app

# Optional: Cloudinary Credentials for Persistent Cloud Attachment Storage
# (Recommended for production to avoid ephemeral local disk storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

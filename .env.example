# ========================================================
# Campus Redressal System — Master Environment Variables
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus-redressal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus-redressal?retryWrites=true&w=majority

# JWT Token Secret Key
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Registration Constraints
# Restricts student registration to this email domain (default: college.edu)
ALLOWED_EMAIL_DOMAIN=college.edu

# Allowed Frontend Origins for CORS (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# Cloudinary Credentials (Optional - Recommended for production cloud storage of complaint attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Configuration (for Vite client builds)
# When deploying frontend separately (e.g. on Vercel/Netlify), set this to your backend's public API URL:
VITE_API_URL=https://your-backend-api.onrender.com/api

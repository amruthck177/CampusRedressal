# Campus Redressal — Environment Variables Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
# If omitted, the server will fallback to using mongodb-memory-server automatically
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus-redressal?retryWrites=true&w=majority

# JWT Token Configuration
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Registration Constraints
# Restrict registration email domain. Students must sign up with this domain (Default: college.edu)
ALLOWED_EMAIL_DOMAIN=college.edu

# Cloudinary Credentials (Optional - Falls back to local multer storage if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Configuration (for Vite client development)
VITE_API_URL=http://localhost:5000/api
